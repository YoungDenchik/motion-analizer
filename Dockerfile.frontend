# ─────────────────────────────────────────────────────────────────────────────
# AI Fitness Coach — Frontend
#
# Multi-stage build:
#   Stage 1 (builder) — Node.js compiles the React + Vite app into static files
#   Stage 2 (runtime) — Nginx serves the static files and proxies /api/ calls
#
# Final image is ~25 MB (nginx:alpine), not ~1 GB (node).
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

# Install deps first (separate layer → cached until package.json changes)
COPY frontend/package.json ./
RUN npm install --silent

# Copy source and build
COPY frontend/ .
RUN npm run build
# Output → /build/dist

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy built React app
COPY --from=builder /build/dist /usr/share/nginx/html

# Copy custom Nginx config (SPA routing + API proxy)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Nginx runs in the foreground by default; keep as-is
